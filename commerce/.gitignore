# ============================================================
# Spring Boot 백엔드 심화 스터디
# 저장소 루트 .gitignore
# ============================================================

# ------------------------------------------------------------
# Gradle
# ------------------------------------------------------------
.gradle/
build/
!**/gradle/wrapper/gradle-wrapper.properties

# gradle-wrapper.jar 은 반드시 커밋한다.
# 6주차 GitHub Actions 에서 ./gradlew test 를 실행하려면 이 파일이 저장소에 있어야 한다.
!**/gradle/wrapper/gradle-wrapper.jar

# ------------------------------------------------------------
# Java 빌드 산출물
# ------------------------------------------------------------
*.class
*.war
*.ear
hs_err_pid*
replay_pid*

# ------------------------------------------------------------
# IDE
# ------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse / STS
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# VS Code
.vscode/

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# ------------------------------------------------------------
# OS
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# 로그 · 임시 파일
# ------------------------------------------------------------
*.log
logs/
*.tmp
*.bak
*.swp
*~

# ------------------------------------------------------------
# H2 (1~5주차 실습)
# ------------------------------------------------------------
# file 모드로 전환하면 프로젝트 폴더에 DB 파일이 생긴다.
*.db
*.mv.db
*.trace.db
*.lock.db

# ------------------------------------------------------------
# 6주차 배포 — 자격증명 (가장 중요)
# ------------------------------------------------------------
# EC2 SSH 키. 실수로 커밋하면 인스턴스가 통째로 노출된다.
*.pem
*.ppk
*.key
id_rsa
id_ed25519

# 환경변수 파일
.env
.env.*
!.env.example

# 로컬 전용 설정 (RDS 비밀번호 등을 여기에 둔다)
**/application-local.yml
**/application-local.yaml
**/application-local.properties
**/application-secret.yml
**/application-secret.yaml
**/*-secret.yml
**/*-secret.yaml

# NOTE: application-prod.yml 은 ignore 하지 않는다.
#       값을 직접 쓰지 않고 ${DB_URL} 같은 환경변수 placeholder 만 두고,
#       실제 값은 GitHub Secrets 와 docker run -e 로 주입한다.
#       (설계서 6.3절 참고)

# AWS
.aws/
*credentials*.csv

# ------------------------------------------------------------
# 도구 설정
# ------------------------------------------------------------
# Claude Code 로컬 설정 (개인 권한 설정이라 공유하지 않는다)
.claude/settings.local.json

# Spring Initializr 안내 파일
HELP.md
